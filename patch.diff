    const template = DOCUMENT_TEMPLATES.find((t) => t.id === doc.templateId) || {
      title: doc.title,
      id: doc.templateId,
    };
    setSelectedTemplate(template);
    setGeneratedDoc(doc.content);
    setStage('preview');
  };
